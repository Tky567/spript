-- Redz Library (tự tải)
local RedzLib = loadstring(game:HttpGet("https://raw.githubusercontent.com/REDzHUB/UI-Library/main/Main.lua"))()

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local LocalPlayer = Players.LocalPlayer
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local HRP = Character:WaitForChild("HumanoidRootPart")

local window = RedzLib:CreateWindow("Bring System")
local tab = window:CreateTab("Main")

local itemList = {}
local creatureList = {}

-- Làm mới danh sách
local function refreshList()
    itemList = {}
    creatureList = {}
    for _, v in ipairs(Workspace:GetDescendants()) do
        if v:IsA("Model") and not Players:GetPlayerFromCharacter(v) then
            if v:FindFirstChildOfClass("Humanoid") then
                creatureList[v.Name] = true
            else
                itemList[v.Name] = true
            end
        end
    end
end

-- Hàm bring model
local function bringByName(name)
    for _, v in ipairs(Workspace:GetDescendants()) do
        if v:IsA("Model") and v.Name == name and not Players:GetPlayerFromCharacter(v) then
            local root = v:FindFirstChild("HumanoidRootPart") or v:FindFirstChildWhichIsA("BasePart")
            if root then
                v.PrimaryPart = root
                v:SetPrimaryPartCFrame(HRP.CFrame * CFrame.new(0, 0, -10))
                for _, d in ipairs(v:GetDescendants()) do
                    if d:IsA("BasePart") then
                        d.Anchored = false
                        d.CanCollide = true
                        d:SetNetworkOwner(LocalPlayer)
                    end
                end
            end
        end
    end
end

-- Convert từ dictionary -> list
local function dictToList(dict)
    local list = {}
    for name in pairs(dict) do
        table.insert(list, name)
    end
    table.sort(list)
    return list
end

-- Giao diện bring item
tab:CreateDropdown("Bring Vật Phẩm", dictToList(itemList), function(selected)
    bringByName(selected)
end)

-- Giao diện bring sinh vật
tab:CreateDropdown("Bring Sinh Vật", dictToList(creatureList), function(selected)
    bringByName(selected)
end)

-- Nút làm mới
tab:CreateButton("🔄 Làm mới danh sách", function()
    refreshList()
    RedzLib:Notify("Làm mới xong!", "Danh sách đã được cập nhật.", 3)
end)

-- Khởi chạy lần đầu
refreshList()