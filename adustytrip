-- Tối ưu: Chỉ quét các object cần thiết
local function scanWorkspace()
    if tick() - lastUpdate < UPDATE_INTERVAL then
        return cachedItems
    end
    
    cachedItems = {}
    local added = {}
    
    -- Chỉ quét các container chính thay vì toàn bộ workspace
    local containers = {workspace}
    
    for _, container in ipairs(containers) do
        for _, item in ipairs(container:GetChildren()) do
            -- Chỉ quét 2 level để tránh lag
            local function scanItem(obj, depth)
                if depth > 2 then return end
                
                if obj:IsA("BasePart") or obj:IsA("Model") then
                    if isWhitelisted(obj.Name) and not isBlacklisted(obj) and not added[obj.Name] then
                        table.insert(cachedItems, obj.Name)
                        added[obj.Name] = true
                    end
                end
                
                for _, child in ipairs(obj:GetChildren()) do
                    scanItem(child, depth + 1)
                end
            end
            
            scanItem(item, 0)
        end
    end
    
    lastUpdate = tick()
    return cachedItems
end

-- Cập nhật dropdown với debounce
local function updateDropdown()
    if isProcessing then return end
    isProcessing = true
    
    local options = scanWorkspace()
    
    task.spawn(function()
        Dropdown:Refresh(options, true)
        task.wait(0.1)
        isProcessing = false
    end)
end

