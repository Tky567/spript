layout.Padding = UDim.new(0, 2)

local objectList = {}

local function hasChanceAny(obj)
	for _, v in ipairs(obj:GetDescendants()) do
		if v.Name:lower() == "chance" then
			return true
		end
	end
	return false
end

local function addObjectButton(name)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, -10, 0, 25)
	btn.Text = name
	btn.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
	btn.TextColor3 = Color3.new(1, 1, 1)
	btn.Parent = scroll
	btn.MouseButton1Click:Connect(function()
		selectedBox.Text = name
	end)
end

local function refreshList()
	scroll:ClearAllChildren()
	layout.Parent = scroll
	objectList = {}
	local unique = {}

	for _, obj in ipairs(workspace:GetDescendants()) do
		if (obj:IsA("Model") or obj:IsA("BasePart")) and not unique[obj.Name] then
			if hasChanceAny(obj) then
				unique[obj.Name] = true
				table.insert(objectList, obj.Name)
				addObjectButton(obj.Name)
			end
		end
	end
end

local function bringItem(name)
	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj.Name == name and (obj:IsA("Model") or obj:IsA("BasePart")) then
			local root = obj:IsA("Model") and obj.PrimaryPart or obj
			if not root and obj:IsA("Model") then
				for _, part in ipairs(obj:GetDescendants()) do
					if part:IsA("BasePart") then
						obj.PrimaryPart = part
						root = part
						break
					end
				end
			end
			if root then
				obj:SetPrimaryPartCFrame(LocalPlayer.Character.HumanoidRootPart.CFrame * CFrame.new(0, 5, 0))
				task.wait(0.2)
				for _, part in ipairs(obj:GetDescendants()) do
					if part:IsA("BasePart") then
						part.Anchored = false
						part.CanCollide = true
						part:SetNetworkOwner(LocalPlayer)
					end
				end
			end
		end
	end
end

refreshBtn.MouseButton1Click:Connect(refreshList)
bringBtn.MouseButton1Click:Connect(function()
	if selectedBox.Text ~= "" then
		bringItem(selectedBox.Text)
	end
end)

refreshList()