-- Cập nhật danh sách hiển thị
local function update()
	scroll:ClearAllChildren()
	local added = {}
	local filter = searchBox.Text:lower()
	local y = 0

	for _, item in ipairs(workspace:GetDescendants()) do
		if not (item:IsA("BasePart") or item:IsA("Model")) then continue end
		if not isWhitelisted(item.Name) then continue end
		if isBlacklisted(item) then continue end
		if added[item.Name] then continue end
		if filter ~= "" and not item.Name:lower():find(filter) then continue end

		added[item.Name] = true

		local btn = Instance.new("TextButton", scroll)
		btn.Size = UDim2.new(1, 0, 0, 25)
		btn.Position = UDim2.new(0, 0, 0, y)
		btn.Text = item.Name
		btn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
		btn.TextColor3 = Color3.new(1, 1, 1)
		btn.Font = Enum.Font.SourceSans
		btn.TextSize = 16

		btn.MouseButton1Click:Connect(function()
			getgenv().selectedItemName = item.Name
			print("✅ Đã chọn:", item.Name)
		end)

		y += 30
	end

	scroll.CanvasSize = UDim2.new(0, 0, 0, y)
end

-- Set PrimaryPart nếu cần
local function trySetPrimary(model)
	if not model.PrimaryPart then
		for _, p in ipairs(model:GetDescendants()) do
			if p:IsA("BasePart") then
				pcall(function() model.PrimaryPart = p end)
				break
			end
		end
	end
end

-- Bring logic
local function bringItems()
	local name = getgenv().selectedItemName
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not name or not hrp then return end
	local targetPos = hrp.Position + Vector3.new(0, 10, 0)

	for _, item in ipairs(workspace:GetDescendants()) do
		if item.Name ~= name then continue end
		if not (item:IsA("BasePart") or item:IsA("Model")) then continue end
		if isBlacklisted(item) then continue end

		local model = item:IsA("Model") and item or item:FindFirstAncestorOfClass("Model")
		if item:IsA("BasePart") then
			item.CFrame = CFrame.new(targetPos)
			item.Anchored = false
			item.CanCollide = true
			task.delay(0.1, function()
				pcall(function() item:SetNetworkOwner(plr) end)
			end)
		elseif model then
			trySetPrimary(model)
			if model.PrimaryPart then
				model:SetPrimaryPartCFrame(CFrame.new(targetPos))
				model.PrimaryPart.Anchored = false
				model.PrimaryPart.CanCollide = true
				task.delay(0.1, function()
					pcall(function() model.PrimaryPart:SetNetworkOwner(plr) end)
				end)
			end
		end
	end
end

