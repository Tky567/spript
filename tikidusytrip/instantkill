local layout = Instance.new("UIListLayout", scroll)
layout.SortOrder = Enum.SortOrder.LayoutOrder
layout.Padding = UDim.new(0, 2)

local npcList = {}

local function addButton(name)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, -10, 0, 25)
	btn.Text = name
	btn.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
	btn.TextColor3 = Color3.new(1, 1, 1)
	btn.Parent = scroll
	btn.MouseButton1Click:Connect(function()
		selectedBox.Text = name
	end)
end

local function refreshList()
	scroll:ClearAllChildren()
	layout.Parent = scroll
	npcList = {}
	local unique = {}

	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") then
			if not unique[obj.Name] then
				unique[obj.Name] = true
				table.insert(npcList, obj.Name)
				addButton(obj.Name)
			end
		end
	end
end

local function killAll(name)
	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("Model") and obj.Name == name then
			local hum = obj:FindFirstChildOfClass("Humanoid")
			if hum then
				hum.Health = 0
			end
		end
	end
end

refreshBtn.MouseButton1Click:Connect(refreshList)
killBtn.MouseButton1Click:Connect(function()
	if selectedBox.Text ~= "" then
		killAll(selectedBox.Text)
	end
end)

refreshList()