-- Safe bring function
local function bringItems()
    if isProcessing then 
        print("⏳ Đang xử lý lệnh khác, vui lòng chờ...")
        return 
    end
    
    local name = getgenv().selectedItemName
    if not name then 
        print("❌ Vui lòng chọn vật thể trước")
        return 
    end
    
    -- Safe character and HumanoidRootPart update
    local currentHRP = getHumanoidRootPart()
    if not currentHRP then 
        print("❌ Character hoặc HumanoidRootPart không tồn tại")
        return 
    end
    
    isProcessing = true
    local broughtCount = 0
    
    -- Safe position calculation
    local success, basePos = pcall(function()
        return currentHRP.Position + Vector3.new(0, getgenv().bringHeight, 0)
    end)
    
    if not success then
        print("❌ Không thể tính toán vị trí bring")
        isProcessing = false
        return
    end
    
    -- Tìm và bring items với giới hạn số lượng
    local maxItems = 10 -- Giới hạn để tránh lag
    local processedItems = 0
    
    local success, descendants = pcall(function()
        return workspace:GetDescendants()
    end)
    
    if not success then
        print("❌ Không thể quét workspace")
        isProcessing = false
        return
    end
    
    for _, item in ipairs(descendants) do
        if processedItems >= maxItems then break end
        if not item or not item.Name then continue end
        if item.Name ~= name then continue end
        if not (item:IsA("BasePart") or item:IsA("Model")) then continue end
        if isBlacklisted(item) then continue end
        
        -- Safe distance check
        local success, itemPos = pcall(function()
            return item:IsA("BasePart") and item.Position or (item.PrimaryPart and item.PrimaryPart.Position)
        end)
        
        if success and itemPos and (itemPos - currentHRP.Position).Magnitude > 1000 then
            continue
        end
        
        processedItems = processedItems + 1
        
        -- Safe position calculation with offset
        local offset = Vector3.new(
            math.random(-getgenv().bringDistance, getgenv().bringDistance),
            0,
            math.random(-getgenv().bringDistance, getgenv().bringDistance)
        )
        local targetPos = basePos + offset
        
        -- Safe bring item
        task.spawn(function()
            local success, _ = pcall(function()
                if item:IsA("BasePart") then
                    item.CFrame = CFrame.new(targetPos)
                    item.Anchored = false
                    item.CanCollide = true
                    
                    -- Safe network ownership
                    task.wait(0.1)
                    pcall(function()
                        if LocalPlayer and LocalPlayer.UserId then
                            item:SetNetworkOwner(LocalPlayer)
                        end
                    end)
                    
                elseif item:IsA("Model") then
                    -- Safe PrimaryPart handling
                    if not item.PrimaryPart then
                        local descendants = item:GetDescendants()
                        for _, part in ipairs(descendants) do
                            if part:IsA("BasePart") then
                                item.PrimaryPart = part
                                break
                            end
                        end
                    end
                    
                    if item.PrimaryPart then
                        item:SetPrimaryPartCFrame(CFrame.new(targetPos))
                        item.PrimaryPart.Anchored = false
                        item.PrimaryPart.CanCollide = true
                        
                        -- Safe network ownership
                        task.wait(0.1)
                        pcall(function()
                            if LocalPlayer and LocalPlayer.UserId then
                                item.PrimaryPart:SetNetworkOwner(LocalPlayer)
                            end
                        end)
                    end
                end
                
                broughtCount = broughtCount + 1
            end)
            
            if not success then
                warn("⚠️ Lỗi khi bring item:", item.Name)
            end
        end)
    end
    
    -- Safe result notification
    task.wait(0.5)
    print(string.format("✅ Đã bring %d item(s) '%s'", broughtCount, name))
    isProcessing = false
end

