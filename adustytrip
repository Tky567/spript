-- Viền highlight
local function highlight(target)
	if not target:IsA("Instance") then return end
	local hl = Instance.new("Highlight")
	hl.FillColor = Color3.fromRGB(255, 255, 0)
	hl.OutlineColor = Color3.new(1, 1, 1)
	hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	hl.Parent = target
end

-- Hiển thị danh sách hợp lệ
local function update()
	scroll:ClearAllChildren()
	local added = {}
	local filter = searchBox.Text:lower()
	local y = 0

	for _, item in ipairs(workspace:GetDescendants()) do
		if (item:IsA("BasePart") or item:IsA("Model")) then
			local name = item.Name
			if not isWhitelisted(name) then continue end
			if isBlacklistedException(item) then continue end
			if added[name] then continue end
			if filter ~= "" and not name:lower():find(filter) then continue end

			added[name] = true

			local btn = Instance.new("TextButton", scroll)
			btn.Size = UDim2.new(1, 0, 0, 25)
			btn.Position = UDim2.new(0, 0, 0, y)
			btn.Text = name
			btn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
			btn.TextColor3 = Color3.new(1, 1, 1)
			btn.Font = Enum.Font.SourceSans
			btn.TextSize = 16

			btn.MouseButton1Click:Connect(function()
				getgenv().selectedItemName = name
				print("✅ Đã chọn:", name)
			end)

			y += 30
		end
	end

	scroll.CanvasSize = UDim2.new(0, 0, 0, y)
end

-- Bring + ownership an toàn
local function trySetPrimary(model)
	if not model.PrimaryPart then
		for _, p in ipairs(model:GetDescendants()) do
			if p:IsA("BasePart") then
				pcall(function() model.PrimaryPart = p end)
				break
			end
		end
	end
end

local function bringItems()
	local name = getgenv().selectedItemName
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not name or not hrp then
		warn("❌ Chưa chọn vật thể hoặc không có HRP")
		return
	end

	local targetPos = hrp.Position + Vector3.new(0, 10, 0)

	for _, item in ipairs(workspace:GetDescendants()) do
		if item.Name == name and (item:IsA("BasePart") or item:IsA("Model")) then
			if isBlacklistedException(item) then continue end
			local model = item:IsA("Model") and item or item:FindFirstAncestorOfClass("Model")

			if item:IsA("BasePart") then
				item.Anchored = false
				item.CanCollide = true
				item.CFrame = CFrame.new(targetPos)
				highlight(item)
				task.delay(0.15, function()
					pcall(function() item:SetNetworkOwner(plr) end)
				end)
			elseif model then
				trySetPrimary(model)
				if model.PrimaryPart then
					model.PrimaryPart.Anchored = false
					model.PrimaryPart.CanCollide = true
					model:SetPrimaryPartCFrame(CFrame.new(targetPos))
					highlight(model)
					task.delay(0.15, function()
						pcall(function() model.PrimaryPart:SetNetworkOwner(plr) end)
					end)
				end
			end
		end
	end
end

