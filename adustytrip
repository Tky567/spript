-- Hàm bring tối ưu
local function bringItems()
    if isProcessing then 
        print("⏳ Đang xử lý lệnh khác, vui lòng chờ...")
        return 
    end
    
    local name = getgenv().selectedItemName
    if not name then 
        print("❌ Vui lòng chọn vật thể trước")
        return 
    end
    
    -- Cập nhật character và HumanoidRootPart
    Character = LocalPlayer.Character
    if not Character then 
        print("❌ Character không tồn tại")
        return 
    end
    
    HumanoidRootPart = Character:FindFirstChild("HumanoidRootPart")
    if not HumanoidRootPart then 
        print("❌ HumanoidRootPart không tồn tại")
        return 
    end
    
    isProcessing = true
    local broughtCount = 0
    
    -- Tính toán vị trí bring
    local basePos = HumanoidRootPart.Position + Vector3.new(0, getgenv().bringHeight, 0)
    
    -- Tìm và bring items với giới hạn số lượng
    local maxItems = 10 -- Giới hạn để tránh lag
    local processedItems = 0
    
    for _, item in ipairs(workspace:GetDescendants()) do
        if processedItems >= maxItems then break end
        
        if item.Name ~= name then continue end
        if not (item:IsA("BasePart") or item:IsA("Model")) then continue end
        if isBlacklisted(item) then continue end
        
        -- Kiểm tra khoảng cách để tránh bring item quá xa
        local itemPos = item:IsA("BasePart") and item.Position or (item.PrimaryPart and item.PrimaryPart.Position)
        if itemPos and (itemPos - HumanoidRootPart.Position).Magnitude > 1000 then
            continue
        end
        
        processedItems = processedItems + 1
        
        -- Tính vị trí bring với offset để tránh chồng chéo
        local offset = Vector3.new(
            math.random(-getgenv().bringDistance, getgenv().bringDistance),
            0,
            math.random(-getgenv().bringDistance, getgenv().bringDistance)
        )
        local targetPos = basePos + offset
        
        -- Bring item
        task.spawn(function()
            pcall(function()
                if item:IsA("BasePart") then
                    item.CFrame = CFrame.new(targetPos)
                    item.Anchored = false
                    item.CanCollide = true
                    
                    -- Tối ưu network ownership
                    task.wait(0.1)
                    pcall(function()
                        item:SetNetworkOwner(LocalPlayer)
                    end)
                    
                elseif item:IsA("Model") then
                    -- Tìm PrimaryPart nếu chưa có
                    if not item.PrimaryPart then
                        for _, part in ipairs(item:GetDescendants()) do
                            if part:IsA("BasePart") then
                                item.PrimaryPart = part
                                break
                            end
                        end
                    end
                    
                    if item.PrimaryPart then
                        item:SetPrimaryPartCFrame(CFrame.new(targetPos))
                        item.PrimaryPart.Anchored = false
                        item.PrimaryPart.CanCollide = true
                        
                        -- Tối ưu network ownership
                        task.wait(0.1)
                        pcall(function()
                            item.PrimaryPart:SetNetworkOwner(LocalPlayer)
                        end)
                    end
                end
                
                broughtCount = broughtCount + 1
            end)
        end)
    end
    
    -- Thông báo kết quả
    task.wait(0.5)
    print(string.format("✅ Đã bring %d item(s) '%s'", broughtCount, name))
    isProcessing = false
end

