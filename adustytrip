local WHITELIST_URL = "https://raw.githubusercontent.com/Tky567/script/refs/heads/Script/whitelist-note.txt"

local plr = game:GetService("Players").LocalPlayer
local char = plr.Character or plr.CharacterAdded:Wait()
local whitelist = {}

-- Tải danh sách trắng
local function loadWhitelist()
	local success, result = pcall(function()
		local res = game:HttpGet(WHITELIST_URL)
		for line in res:gmatch("[^\r\n]+") do
			table.insert(whitelist, line:lower())
		end
	end)
	if not success then
		warn("⚠️ Không tải được whitelist:", result)
	end
end

-- Kiểm tra hợp lệ
local function isWhitelisted(name)
	local lname = name:lower()
	for _, allow in ipairs(whitelist) do
		if lname == allow then return true end
	end
	return false
end

-- Danh sách đen đặc biệt (engine trong van/sedan)
local function isBlacklisted(item)
	if item.Name ~= "engine" then return false end
	local van = workspace:FindFirstChild("van")
	local sedan = workspace:FindFirstChild("sedan")
	if van and item:IsDescendantOf(van) then return true end
	if sedan and item:IsDescendantOf(sedan) then return true end
	return false
end

loadWhitelist()

