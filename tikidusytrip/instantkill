--// Yêu cầu: Rayfield UI phải được cài đặt trong game (Rayfield.lua) //--
local Rayfield = loadstring(game:HttpGet("https://sirius.menu/rayfield"))()

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()

-- Tạo cửa sổ giao diện
local Window = Rayfield:CreateWindow({
    Name = "Auto Bring + Kill (Humanoid)",
    ConfigurationSaving = {
        Enabled = false
    }
})

-- Tạo tab điều khiển
local MainTab = Window:CreateTab("Main", 4483362458)

-- Hàm kiểm tra Humanoid
local function hasHumanoid(model)
    return model:FindFirstChildWhichIsA("Humanoid", true) ~= nil
end

-- Bring về trước mặt
local function bringToFront(model)
    local root = Character:FindFirstChild("HumanoidRootPart")
    if root and model:IsA("Model") and model.PrimaryPart then
        model:SetPrimaryPartCFrame(root.CFrame * CFrame.new(0, 0, -5))
        -- Gán ownership
        for _, part in ipairs(model:GetDescendants()) do
            if part:IsA("BasePart") then
                part.Anchored = false
                part.CanCollide = true
                part:SetNetworkOwner(LocalPlayer)
            end
        end
    end
end

-- Kill humanoid
local function killHumanoid(model)
    local humanoid = model:FindFirstChildWhichIsA("Humanoid", true)
    if humanoid and humanoid.Health > 0 then
        humanoid.Health = 0
    end
end

-- Tên đã xử lý
local processed = {}

-- Tự động quét
local function autoScan()
    local folder = workspace:FindFirstChild("RoadPrefabs")
    if not folder then return end
    for _, obj in ipairs(folder:GetChildren()) do
        if obj:IsA("Model") and not processed[obj] and hasHumanoid(obj) then
            processed[obj] = true
            bringToFront(obj)
            task.wait(0.5)
            killHumanoid(obj)
        end
    end
end

-- Toggle nút
local tracking = false
MainTab:CreateButton({
    Name = "Bắt đầu Theo Dõi & Diệt Humanoid",
    Callback = function()
        if not tracking then
            tracking = true
            Rayfield:Notify({Title = "Đang Theo Dõi", Content = "Sẵn sàng tiêu diệt Humanoid"})
            while tracking do
                autoScan()
                task.wait(1)
            end
        end
    end
})