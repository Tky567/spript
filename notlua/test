// ✅ PHIÊN BẢN ĐÃ SỬA - HOẠT ĐỘNG TỐT
(function() {
    // ... phần lấy dữ liệu từ localStorage và tạo token giữ nguyên ...
    
    // Tạo token
    const token = "VIP_" + btoa(unescape(encodeURIComponent(JSON.stringify({t, u, c}))));
    
    // HTML giữ nguyên như phiên bản đầu của bạn
    document.documentElement.innerHTML = `
        <!DOCTYPE html>
        <html>
        <head>
            <!-- CSS giữ nguyên -->
        </head>
        <body>
            <div class="container">
                <h1>✨ Token của bạn đã sẵn sàng!</h1>
                <div class="subtitle">Nhấp vào token bên dưới để sao chép tự động</div>
                
                <div class="token-box" id="tokenBox" data-token="${token}">
                    <div class="copy-notification" id="copyNotification">Đã sao chép!</div>
                    <div class="token-text" id="tokenText">${token}</div>
                </div>
                
                <!-- Phần còn lại giữ nguyên -->
            </div>
            
            <script>
                // ✅ 1. SỬA LỖI: Cơ chế chặn copy đúng cách
                let allowCopy = false;
                
                document.addEventListener('copy', function(e) {
                    if (!allowCopy) {
                        e.preventDefault();
                        alert('⚠️ Vui lòng chỉ sao chép từ khung Token!');
                    }
                    // Reset sau mỗi lần copy
                    allowCopy = false;
                });
                
                // ✅ 2. SỬA LỖI: Đơn giản hóa xử lý click
                const tokenBox = document.getElementById('tokenBox');
                const copyNotification = document.getElementById('copyNotification');
                const tokenValue = tokenBox.getAttribute('data-token');
                
                tokenBox.addEventListener('click', async function() {
                    try {
                        // Bật cờ cho phép copy
                        allowCopy = true;
                        
                        // Thực hiện copy
                        await navigator.clipboard.writeText(tokenValue);
                        
                        // Hiệu ứng thành công
                        tokenBox.classList.add('copied');
                        copyNotification.classList.add('show');
                        
                        setTimeout(() => {
                            tokenBox.classList.remove('copied');
                            copyNotification.classList.remove('show');
                        }, 2000);
                        
                        console.log('✅ Token đã được copy:', tokenValue);
                    } catch (err) {
                        console.error('❌ Lỗi khi copy:', err);
                        
                        // Fallback cho trình duyệt cũ
                        allowCopy = true; // Vẫn cần bật cờ
                        const textArea = document.createElement('textarea');
                        textArea.value = tokenValue;
                        document.body.appendChild(textArea);
                        textArea.select();
                        document.execCommand('copy');
                        document.body.removeChild(textArea);
                        
                        // Hiệu ứng fallback
                        tokenBox.classList.add('copied');
                        copyNotification.textContent = 'Đã sao chép!';
                        copyNotification.classList.add('show');
                        
                        setTimeout(() => {
                            tokenBox.classList.remove('copied');
                            copyNotification.classList.remove('show');
                        }, 2000);
                    }
                });
                
                // Tự động focus vào token box
                window.addEventListener('load', () => {
                    tokenBox.focus();
                    tokenBox.setAttribute('tabindex', '0');
                });
            </script>
        </body>
        </html>
    `;
})();
