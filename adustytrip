local WHITELIST_URL = "https://raw.githubusercontent.com/Tky567/script/refs/heads/Script/whitelist-note.txt"
local UPDATE_INTERVAL = 5 -- Cập nhật dropdown mỗi 5 giây thay vì liên tục

-- Services
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

