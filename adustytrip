-- Safe HTTP request with retry mechanism
local function safeHttpGet(url, maxRetries)
    maxRetries = maxRetries or 3
    local retries = 0
    
    while retries < maxRetries do
        local success, result = pcall(function()
            return game:HttpGet(url)
        end)
        
        if success then
            return result
        else
            retries = retries + 1
            warn("🔄 Retry HTTP request (" .. retries .. "/" .. maxRetries .. "): " .. tostring(result))
            task.wait(1)
        end
    end
    
    return nil
end

-- Tải whitelist từ URL với error handling
local function loadWhitelist()
    local result = safeHttpGet(WHITELIST_URL)
    if not result then
        warn("⚠️ Không thể tải whitelist sau nhiều lần thử")
        return false
    end
    
    whitelist = {}
    for line in result:gmatch("[^\r\n]+") do
        local trimmed = line:match("^%s*(.-)%s*$") -- Trim whitespace
        if trimmed and trimmed ~= "" then
            table.insert(whitelist, trimmed:lower())
        end
    end
    
    print("✅ Đã tải whitelist thành công:", #whitelist, "items")
    return true
end

-- Kiểm tra whitelist nhanh hơn bằng dictionary
local whitelistDict = {}
local function buildWhitelistDict()
    whitelistDict = {}
    for _, name in ipairs(whitelist) do
        whitelistDict[name] = true
    end
end

local function isWhitelisted(name)
    if not name then return false end
    return whitelistDict[name:lower()] or false
end

local function isBlacklisted(item)
    if not item or not item.Name then return false end
    if item.Name ~= "engine" then return false end
    
    local van = workspace:FindFirstChild("van")
    local sedan = workspace:FindFirstChild("sedan")
    
    return (van and item:IsDescendantOf(van)) or (sedan and item:IsDescendantOf(sedan))
end

