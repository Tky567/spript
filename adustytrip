-- Safe workspace scanning
local function scanWorkspace()
    if tick() - lastUpdate < UPDATE_INTERVAL then
        return cachedItems
    end
    
    cachedItems = {}
    local added = {}
    
    -- Safe workspace check
    if not workspace then
        warn("❌ Workspace không tồn tại")
        return cachedItems
    end
    
    -- Chỉ quét các container chính thay vì toàn bộ workspace
    local containers = {workspace}
    
    for _, container in ipairs(containers) do
        if not container then continue end
        
        local success, children = pcall(function()
            return container:GetChildren()
        end)
        
        if not success then continue end
        
        for _, item in ipairs(children) do
            if not item then continue end
            
            -- Chỉ quét 2 level để tránh lag
            local function scanItem(obj, depth)
                if depth > 2 or not obj then return end
                
                local success, _ = pcall(function()
                    if obj:IsA("BasePart") or obj:IsA("Model") then
                        if obj.Name and isWhitelisted(obj.Name) and not isBlacklisted(obj) and not added[obj.Name] then
                            table.insert(cachedItems, obj.Name)
                            added[obj.Name] = true
                        end
                    end
                    
                    local children = obj:GetChildren()
                    for _, child in ipairs(children) do
                        scanItem(child, depth + 1)
                    end
                end)
                
                if not success then
                    -- Silently skip errored items
                    return
                end
            end
            
            scanItem(item, 0)
        end
    end
    
    lastUpdate = tick()
    return cachedItems
end

-- Safe dropdown update
local function updateDropdown()
    if isProcessing then return end
    isProcessing = true
    
    local success, options = pcall(function()
        return scanWorkspace()
    end)
    
    if not success then
        warn("⚠️ Lỗi khi quét workspace:", options)
        isProcessing = false
        return
    end
    
    task.spawn(function()
        pcall(function()
            Dropdown:Refresh(options, true)
        end)
        task.wait(0.1)
        isProcessing = false
    end)
end

